{
  "expo": {
    "name": "Pay in 3",
    "slug": "pay-in-3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "payin3",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1DB954"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.payin3.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1DB954"
      },
      "edgeToEdgeEnabled": true,
      "package": "co.payin3.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pay in 3 necesita acceso a tus fotos para verificar tu identidad.",
          "cameraPermission": "Pay in 3 necesita acceso a tu camara para tomar tu selfie y foto de cedula."
        }
      ]
    ]
  }
}
